# Copy this file to .streamlit/secrets.toml and fill in real values.
# NEVER commit the real secrets.toml (it is already covered by .gitignore).

# --- Google OAuth 2.0 (Web application client) ---
# Create at: https://console.cloud.google.com/apis/credentials
# Enable the "Google Sheets API" and "Google Drive API" for the project.
# Add OAUTH_REDIRECT_URI below to the client's "Authorized redirect URIs".
GOOGLE_CLIENT_ID = "xxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET = "your-client-secret"
OAUTH_REDIRECT_URI = "http://localhost:8501"   # production: your deployed URL

# --- OpenRouter (OpenAI-compatible Structured Outputs) ---
# Get a key at: https://openrouter.ai/keys
# Choose a model that supports structured outputs, namespaced "<provider>/<model>".
OPENROUTER_API_KEY = "sk-or-v1-..."
OPENROUTER_MODEL = "openai/gpt-4o-mini"
# Optional overrides:
# OPENROUTER_BASE_URL = "https://openrouter.ai/api/v1"
# APP_PUBLIC_URL = "https://your-app.streamlit.app"   # used for OpenRouter attribution headers
